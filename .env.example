# Copiar a .env (dev) / .env.production (prod) — nunca commitear el real.

NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://ap_contadores:ap_contadores@localhost:5432/ap_contadores_dev

# Auth
JWT_SECRET=cambiar-en-cada-ambiente
JWT_EXPIRES_IN=8h

# Cifrado de datos sensibles en reposo (ej: certificado_afip.clave_privada — nota 09).
# NUNCA el mismo valor entre ambientes, NUNCA committeado.
MASTER_ENCRYPTION_KEY=cambiar-en-cada-ambiente

# CORS
WEB_ORIGIN=http://localhost:5173
