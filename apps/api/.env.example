# Copiar a .env (dev) — nunca commitear el real. Ver tambien el .env.example de la raiz.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://ap_contadores:ap_contadores@localhost:5432/ap_contadores_dev

JWT_ACCESS_SECRET=cambiar-en-cada-ambiente
