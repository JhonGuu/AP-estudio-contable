{
  "name": "ap-contadores",
  "private": true,
  "version": "0.0.1",
  "description": "AP-Contadores \u2014 SaaS multi-tenant de gestion contable para estudios contables (Argentina)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "pnpm --filter @ap-contadores/api dev",
    "dev:web": "pnpm --filter @ap-contadores/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @ap-contadores/api db:generate",
    "db:migrate": "pnpm --filter @ap-contadores/api db:migrate",
    "db:seed": "pnpm --filter @ap-contadores/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
